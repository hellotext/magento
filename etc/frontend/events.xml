<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_logout">
        <observer name="hellotext_anonymous_logout" instance="Hellotext\Tracking\Observer\ResetAnonymousSession"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="hellotext_order_session" instance="Hellotext\Tracking\Observer\RememberOrderSession"/>
    </event>
</config>
