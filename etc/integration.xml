<?xml version="1.0"?>
<!--
  Declared integration: Magento creates it on setup:upgrade with fixed URLs and resources, so the
  merchant only activates it. Changing any URL or resource here makes Magento delete and recreate
  the integration, which forces every merchant to authorize again: treat this file as frozen.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Integration:etc/integration/integration.xsd">
    <integration name="Hellotext">
        <email>support@hellotext.com</email>
        <endpoint_url>https://www.hellotext.com/oauth/magento/callback</endpoint_url>
        <identity_link_url>https://www.hellotext.com/magento/connect</identity_link_url>
        <resources>
            <resource name="Magento_Backend::store"/>
            <resource name="Hellotext_Tracking::configure"/>
            <resource name="Hellotext_Tracking::delivery"/>
            <resource name="Hellotext_Tracking::catalog_read"/>
            <resource name="Hellotext_Tracking::customer_read"/>
        </resources>
    </integration>
</config>
